# The bare domain only serves room pages under /r/; the root sends people to the student app.
server {
    listen 443 ssl;
    http2 on;
    server_name ${HOST_APEX};
    include /etc/nginx/conf.d/tls.inc;
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-apex.inc;

    location = / {
        return 302 https://${HOST_SP}/;
    }
}
