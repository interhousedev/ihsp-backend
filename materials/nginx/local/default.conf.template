# Edge nginx (local full stack): plain HTTP on port 80, hosts under *.localhost.
# Rendered by the nginx image's entrypoint (envsubst over HOST_*) into /etc/nginx/conf.d/.
# Same routes as production (materials/nginx/common), without TLS.

resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
client_max_body_size 25m;
proxy_connect_timeout 5s;
proxy_send_timeout 60s;
proxy_read_timeout 120s;

# Healthcheck and unknown host names.
server {
    listen 80 default_server;
    server_name _;

    include /etc/nginx/ihsp/health.inc;

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name ${HOST_ID};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-id.inc;
}

server {
    listen 80;
    server_name ${HOST_SP};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-static.inc;
}

server {
    listen 80;
    server_name ${HOST_STAFF};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-static.inc;
}

server {
    listen 80;
    server_name ${HOST_ADMIN};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-static.inc;
}

server {
    listen 80;
    server_name ${HOST_LMS};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-static.inc;
}

server {
    listen 80;
    server_name ${HOST_S};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-s.inc;
}

server {
    listen 80;
    server_name ${HOST_API};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-api.inc;
}

server {
    listen 80;
    server_name ${HOST_MCP};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-mcp.inc;
}

server {
    listen 80;
    server_name ${HOST_APEX};
    include /etc/nginx/ihsp/upstreams.inc;
    include /etc/nginx/ihsp/route-apex.inc;

    location = / {
        return 302 http://${HOST_SP}/;
    }
}
