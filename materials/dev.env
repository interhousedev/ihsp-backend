# Working development values for scripts/dev.sh and `IHSP_ENV_FILE=materials/dev.env`.
# Files can be layered: `IHSP_ENV_FILE=materials/dev.env,?.env.local` lets .env.local
# (git-ignored, optional) override single values.
# No real secrets: everything here only works against the local compose stack.
IHSP_ENV=dev
IHSP_LOG_LEVEL=INFO
IHSP_PUBLIC_APP_NAME=IHT

IHSP_DATABASE__URL=postgresql+asyncpg://ihsp:ihsp@localhost:5433/ihsp
IHSP_DATABASE__POOL_SIZE=10
IHSP_REDIS__URL=redis://localhost:6380/0

IHSP_S3__ENDPOINT_URL=http://localhost:9000
IHSP_S3__PUBLIC_ENDPOINT_URL=http://localhost:9000
IHSP_S3__REGION=us-east-1
IHSP_S3__ACCESS_KEY=minio
IHSP_S3__SECRET_KEY=minio12345
IHSP_S3__BUCKET=ihsp-dev

IHSP_VAULT__URL=http://localhost:8200
IHSP_VAULT__TOKEN=dev-root
IHSP_VAULT__VERIFY=true
IHSP_VAULT__TRANSIT_KEY=emis-passwords
IHSP_VAULT__KV_MOUNT=secret
IHSP_VAULT__KV_PREFIX=emis

IHSP_HYDRA__PUBLIC_URL=http://localhost:4444
IHSP_HYDRA__ADMIN_URL=http://localhost:4445
IHSP_HYDRA__ISSUER=http://localhost:4444/
IHSP_HYDRA__JWKS_CACHE_SECONDS=300

IHSP_JWT_BEARER__ISSUER=ihsp-identity
IHSP_JWT_BEARER__KEY_ID=ihsp-identity-1
# scripts/dev.sh generates this key (RSA 2048) when it is missing.
IHSP_JWT_BEARER__PRIVATE_KEY_PATH=materials/dev-keys/jwt-bearer.pem

IHSP_TOKENS__ACCESS_TTL_SECONDS=600
IHSP_TOKENS__REFRESH_COOKIE_SECURE=false
IHSP_TOKENS__COOKIE_PREFIX=rt_
IHSP_TOKENS__SERVICE_TOKEN=dev-service-token

IHSP_TELEGRAM__BOT_TOKEN=000:dev
IHSP_TELEGRAM__BOT_USERNAME=ihspbot
IHSP_TELEGRAM__MODE=fake
IHSP_TELEGRAM__INIT_DATA_MAX_AGE_SECONDS=3600

IHSP_EMIS__MODE=fake
IHSP_EMIS__BASE_URL=https://emis.edu.uz/api/v1/
IHSP_EMIS__PROFILE_PATH=student-profiles/profile/
IHSP_EMIS__INSTITUTION_ID=10815
IHSP_EMIS__CONCURRENCY=20
IHSP_EMIS__REQUEST_DELAY_MS=0
IHSP_EMIS__GATEWAY_URL=http://localhost:8000/internal/emis

IHSP_OPENROUTER__MODE=fake
IHSP_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
IHSP_OPENROUTER__APP_URL=https://my.ihsu.uz
IHSP_OPENROUTER__APP_TITLE=IHT
IHSP_OPENROUTER__TIMEOUT_SECONDS=90

# The real key goes in materials/dev-keys/secrets.env (git-ignored), loaded after this file.
IHSP_OPENROUTER__API_KEY=

# Models per task: the default, and the smart tier of the student assistant. Any other
# task is overridden with IHSP_AI__TASKS__<TASK>__MODEL (docs/reference/settings.md).
IHSP_AI__DEFAULT__MODEL=anthropic/claude-haiku-4.5
IHSP_AI__DEFAULT__TEMPERATURE=0.2
IHSP_AI__TASKS__STUDENT_CHAT_SMART__MODEL=anthropic/claude-sonnet-5.5
IHSP_AI__TASKS__STUDENT_CHAT_SMART__BUDGET_WEIGHT=4

# Feature flags (a layered file such as `?.env.local` can switch one off).
IHSP_FEATURES__NOTEBOOKS=true
IHSP_FEATURES__AI_ASSISTANT=true
IHSP_FEATURES__FLASHCARDS=true
IHSP_FEATURES__LMS=true
IHSP_FEATURES__MAIL=true
IHSP_FEATURES__PUSH=true
IHSP_FEATURES__EMIS_SYNC=true
IHSP_FEATURES__LIBRARY=true
IHSP_FEATURES__WEB_SEARCH=true

IHSP_SMTP_OUT__HOST=localhost
IHSP_SMTP_OUT__PORT=1025
IHSP_SMTP_OUT__STARTTLS=false
IHSP_SMTP_OUT__MAIL_DOMAIN=mail.ihsu.uz
IHSP_SMTP_OUT__SYSTEM_FROM=no-reply@ihsu.uz
IHSP_MAIL__OUTBOUND__ENABLED=true
IHSP_MAIL__OUTBOUND__HOST=localhost
IHSP_MAIL__OUTBOUND__PORT=1025

IHSP_SMTP_IN__HOST=0.0.0.0
IHSP_SMTP_IN__PORT=2525
IHSP_SMTP_IN__MAX_BYTES=26214400
IHSP_SMTP_IN__CHECK_SPF=false
IHSP_SMTP_IN__CHECK_DKIM=false

IHSP_URLS__ID=http://localhost:3001
IHSP_URLS__SP=http://localhost:3002
IHSP_URLS__APP=http://localhost:3007
IHSP_URLS__STAFF=http://localhost:3003
IHSP_URLS__ADMIN=http://localhost:3004
IHSP_URLS__LMS=http://localhost:3005
IHSP_URLS__SHARE=http://localhost:3006
IHSP_URLS__LIBRARY=http://localhost:3008
IHSP_URLS__SHORT_LINKS=http://localhost:8000/s
IHSP_URLS__ROOMS=http://localhost:8000/r
IHSP_URLS__API=http://localhost:8000
IHSP_URLS__MCP=http://localhost:8000/mcp

# --- Installable app (PWA at app.<domain>) ---
# Versions served by GET /v1/app/version. The app compares its build version with them:
#   LATEST        newest build; an older client offers an update.
#   MIN_SUPPORTED oldest build allowed to keep running; clients below it update immediately
#                 (forced update). Raise it to push everybody onto a new build (LATEST >= MIN_SUPPORTED).
# IHSP_APP__LATEST=1.0.0
# IHSP_APP__MIN_SUPPORTED=1.0.0

IHSP_LIMITS__STORAGE_STUDENT_BYTES=1610612736
IHSP_LIMITS__STORAGE_STAFF_BYTES=10737418240
IHSP_LIMITS__FILE_MAX_BYTES=104857600
IHSP_LIMITS__AI_TEXT_MAX_BYTES=102400
IHSP_LIMITS__AI_SESSION_HOURS=5
IHSP_LIMITS__AI_SESSION_TOKENS_STUDENT=200000
IHSP_LIMITS__AI_DAILY_TOKENS_STUDENT=600000
IHSP_LIMITS__AI_MAX_TOOL_STEPS=8
IHSP_LIMITS__NB_SESSION_TOKENS_STUDENT=1500000
IHSP_LIMITS__NB_DAILY_TOKENS_STUDENT=4000000
IHSP_LIMITS__NB_ARTIFACTS_PER_DAY=20
IHSP_LIMITS__NB_AUDIO_PER_DAY=0
IHSP_LIMITS__NB_SLIDES_PER_DAY=6
IHSP_LIMITS__NB_INFOGRAPHICS_PER_DAY=6
IHSP_LIMITS__NB_CONCURRENT_ARTIFACTS=3
IHSP_LIMITS__NB_CHAT_PER_MINUTE=10
IHSP_LIMITS__NB_SOURCE_ADDS_PER_HOUR=60
IHSP_LIMITS__NB_SEARCH_PER_MINUTE=30
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STUDENT=10
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STAFF=30
IHSP_LIMITS__WEB_SEARCH_MAX_RESULTS=5
IHSP_LIMITS__WEB_SEARCH_DISCOVER_RESULTS=8
IHSP_LIMITS__WEB_SEARCH_DEEP_QUERIES=3
IHSP_LIMITS__WEB_SEARCH_DEEP_RESULTS=12

# Notebooks (NotebookLM-style)
IHSP_NOTEBOOKS__ENABLED=true
IHSP_NOTEBOOKS__LLM_TIMEOUT_SECONDS=180
IHSP_NOTEBOOKS__MAX_NOTEBOOKS=50
IHSP_NOTEBOOKS__MAX_SOURCES=50
IHSP_NOTEBOOKS__SOURCE_MAX_CHARS=600000
IHSP_NOTEBOOKS__NOTEBOOK_MAX_CHARS=4000000
IHSP_NOTEBOOKS__ADD_BATCH_MAX=20
IHSP_NOTEBOOKS__MAX_ARTIFACTS=60
IHSP_NOTEBOOKS__CHAT_FULL_CONTEXT_TOKENS=80000
IHSP_NOTEBOOKS__STUDIO_CONTEXT_TOKENS=150000

# Library (lib.ihsu.uz); sizes in bytes, times in seconds
IHSP_LIBRARY__FILE_MAX_BYTES=314572800               # 300 MiB per book file
IHSP_LIBRARY__MATERIAL_STUDENT_MAX_BYTES=20971520    # 20 MiB
IHSP_LIBRARY__MATERIAL_STUDENT_MAX_PAGES=60
IHSP_LIBRARY__MATERIAL_TEACHER_MAX_BYTES=104857600   # 100 MiB
IHSP_LIBRARY__STUDENT_QUOTA_BYTES=314572800          # 300 MiB
IHSP_LIBRARY__TEACHER_QUOTA_BYTES=2147483648         # 2 GiB
IHSP_LIBRARY__READER_URL_SECONDS=900
IHSP_LIBRARY__TEACHER_REVIEW=false                   # true: teachers' materials also wait in the queue
IHSP_LIBRARY__LIST_MAX_ITEMS=100
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_STUDENT=10
IHSP_LIBRARY__LIMIT_UPLOADS_WEEK_STUDENT=40
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_TEACHER=30
IHSP_LIBRARY__LIMIT_REPORTS_DAY=10
IHSP_LIBRARY__AUTO_HOLD_REPORTERS=2
IHSP_LIBRARY__QUEUE_SLA_SCHOOL_DAYS=2
IHSP_LIBRARY__OFFLINE_MAX_ITEMS=5
IHSP_LIBRARY__OFFLINE_MAX_BYTES=419430400            # 400 MiB
IHSP_LIBRARY__PUBLIC_BASE_URL=http://localhost:3008
IHSP_LIBRARY__TAXONOMY_CACHE_TTL=604800
# UniLibrary is a switched-off base: link-only cards, never their files.
IHSP_LIBRARY__UNILIBRARY_ENABLED=false
IHSP_LIBRARY__UNILIBRARY_ANONYMOUS_CARDS=false
IHSP_LIBRARY__UNILIBRARY_BASE_URL=https://api.unilibrary.uz
IHSP_LIBRARY__UNILIBRARY_RPS=3
IHSP_LIBRARY__UNILIBRARY_CONCURRENCY=2
IHSP_LIBRARY__UNILIBRARY_LIST_TIMEOUT=8
IHSP_LIBRARY__UNILIBRARY_DETAIL_TIMEOUT=5
IHSP_LIBRARY__UNILIBRARY_CACHE_LIST_TTL=600
IHSP_LIBRARY__UNILIBRARY_CACHE_DETAIL_TTL=86400
IHSP_LIBRARY__UNILIBRARY_STALE_TTL=604800
IHSP_LIBRARY__UNILIBRARY_BREAKER_FAILURES=3
IHSP_LIBRARY__UNILIBRARY_BREAKER_SECONDS=60
IHSP_LIBRARY__UNILIBRARY_USER_AGENT="IHSP-library/1.0 (+https://ihsu.uz)"
IHSP_LIBRARY__UNILIBRARY_CONTACT=                    # added to the User-Agent when set
IHSP_LIBRARY__UNILIBRARY_USER_SEARCHES_PER_MIN=30
IHSP_LIBRARY__UNILIBRARY_DESCRIPTION_MAX=600

# Web Push (VAPID). scripts/dev.sh generates materials/dev-keys/vapid.env (git-ignored) and
# exports IHSP_PUSH__ENABLED=true with a key pair; without it push stays off. Running
# `python -m app` by hand: `set -a; source materials/dev-keys/vapid.env; set +a`.
IHSP_PUSH__ENABLED=false
IHSP_PUSH__SUBJECT=mailto:dev@ihsu.uz
IHSP_LIMITS__MAIL_PER_DAY=20
IHSP_LIMITS__MAIL_RECIPIENTS=5
IHSP_LIMITS__MAIL_GLOBAL_PER_DAY=2000
IHSP_LIMITS__OTP_CODES_PER_HOUR=5
IHSP_LIMITS__OTP_FAILURES_PER_DAY=10
IHSP_LIMITS__ROOM_PIN_ATTEMPTS=5
IHSP_LIMITS__ATTENDANCE_EDIT_DAYS=7
