# Production configuration for materials/docker-compose.prod.yaml.
#
#   scripts/prod_init.sh env      copies this file to .env.prod and generates every secret
#                                 whose value is CHANGE_ME_GENERATED
#   then edit the values marked  >>> SET <<<  (they are CHANGE_ME) and run the rest of
#   scripts/prod_init.sh on the server.
#
# .env.prod is a secret: mode 600, never commit it, never send it by chat. Compose reads it
# with `--env-file`; only the variables named in the compose file reach the containers.
# Values must not contain spaces, quotes, `$`, `#` or `|` (generated secrets are hex).

# ------------------------------------------------------------------ deployment
# >>> SET <<< the registrable domain; hosts are id., my., app., staff., admin., lms., lib., s.,
# api., mcp. and mail. under it, plus the bare domain for room pages (<domain>/r/...).
# app.<domain> is the installable app (the sp build with its own runtime config);
# lib.<domain> is the library app (books and materials; its /b/, /sitemap.xml, /robots.txt
# and /opds/ pages come from the api process).
DOMAIN=ihsu.uz
# >>> SET <<< contact address for Let's Encrypt expiry notices.
ACME_EMAIL=CHANGE_ME
# >>> SET <<< GitHub user or organisation that owns ghcr.io/<owner>/ihsp-backend and ihsp-web,
# in lower case (.github/workflows/build.yml lower-cases it).
IMAGE_OWNER=CHANGE_ME
# >>> SET <<< image tag to deploy. A release tag v1.0.0 is published as `1.0.0` (no `v`); every
# push to main is also published as `sha-<40 hex of the commit>`, `main` and `latest`. Prefer a
# release version or a sha tag: they do not move.
TAG=CHANGE_ME
LOG_LEVEL=INFO
# Apps that also run as installable apps on their own host (the student app always does, on
# app.<domain>). Optional; default `lms library staff admin`.
# PWA_APPS=lms library staff admin
# Installable app (app.<domain>) versions, served by GET /v1/app/version; the app compares its
# build version with them. Optional, both default to 1.0.0 (nobody is asked to update).
#   LATEST        the newest build; older clients offer an update.
#   MIN_SUPPORTED the oldest build allowed to keep running; clients below it update immediately
#                 (forced update). Keep it <= LATEST and raise it only when old builds must go.
# IHSP_APP__LATEST=1.0.0
# IHSP_APP__MIN_SUPPORTED=1.0.0
# Address plan of the `edge` Docker network; nginx has a fixed address in it and uvicorn
# trusts X-Forwarded-For only from that address. Change both if the range clashes.
EDGE_SUBNET=172.31.240.0/24
EDGE_NGINX_IP=172.31.240.10

# --------------------------------------------------------- generated secrets
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
HYDRA_DB_PASSWORD=CHANGE_ME_GENERATED
REDIS_PASSWORD=CHANGE_ME_GENERATED
# Hydra: each at least 16 characters, stable across restarts. Rotating them follows
# docs/reference/hydra.md (keep the old value for verification).
HYDRA_SECRET_SYSTEM=CHANGE_ME_GENERATED
HYDRA_SECRET_COOKIE=CHANGE_ME_GENERATED
HYDRA_SECRET_PAGINATION=CHANGE_ME_GENERATED
# Shared by Hydra's token hook, the worker/scheduler (EMIS gateway) and identity.
IHSP_TOKENS__SERVICE_TOKEN=CHANGE_ME_GENERATED
# Telegram webhook path secret and secret_token header.
IHSP_TELEGRAM__WEBHOOK_SECRET=CHANGE_ME_GENERATED
# Secret of the confidential Hydra client `miniapp` (Telegram mini app token grant); set in
# Hydra by scripts/hydra_bootstrap.py and read by identity.
IHSP_HYDRA__MINIAPP_CLIENT_SECRET=CHANGE_ME_GENERATED

# ---------------------------------------------------------------- object storage
# Production default: the cloud provider's S3. >>> SET <<< all five values.
# PUBLIC_ENDPOINT_URL is the host browsers use for presigned URLs (usually the same).
IHSP_S3__ENDPOINT_URL=CHANGE_ME
IHSP_S3__PUBLIC_ENDPOINT_URL=CHANGE_ME
IHSP_S3__REGION=us-east-1
IHSP_S3__ACCESS_KEY=CHANGE_ME
IHSP_S3__SECRET_KEY=CHANGE_ME
IHSP_S3__BUCKET=ihsp
# Single-host alternative: `docker compose --profile rustfs up -d` runs RustFS. Then use
#   IHSP_S3__ENDPOINT_URL=http://s3:9000
#   IHSP_S3__PUBLIC_ENDPOINT_URL=https://storage.<domain>
#   STORAGE_PUBLIC_HOST=storage.<domain>   (add a DNS A record for it)
# and generate IHSP_S3__ACCESS_KEY / IHSP_S3__SECRET_KEY yourself.
# STORAGE_PUBLIC_HOST=

# ----------------------------------------------------------------------- Telegram
# >>> SET <<< token from @BotFather.
IHSP_TELEGRAM__BOT_TOKEN=CHANGE_ME
IHSP_TELEGRAM__BOT_USERNAME=ihspbot
# Production uses the webhook at https://api.<domain>/telegram/<webhook secret>.
IHSP_TELEGRAM__MODE=webhook
# Chat that receives error reports (optional; leave commented out when unknown).
# IHSP_TELEGRAM__ADMIN_CHAT_ID=

# -------------------------------------------------------------------------- EMIS
IHSP_EMIS__MODE=real
IHSP_EMIS__BASE_URL=https://emis.edu.uz/api/v1/
IHSP_EMIS__PROFILE_PATH=student-profiles/profile/
IHSP_EMIS__INSTITUTION_ID=10815

# --------------------------------------------------------------------- OpenRouter
IHSP_OPENROUTER__MODE=real
# >>> SET <<<
IHSP_OPENROUTER__API_KEY=CHANGE_ME

# ------------------------------------------------------------------------------ Exa
# Web search (chat and Discover). Real mode needs the key; the compose file forwards it
# to api and worker only.
IHSP_EXA__MODE=real
# >>> SET <<<
IHSP_EXA__API_KEY=CHANGE_ME
# Models per task: one default and optional overrides (docs/reference/settings.md).
# Tasks: STUDENT_CHAT, STUDENT_CHAT_SMART (ships with google/gemini-3.8-flash, effort low
# and budget weight 8), ADMIN_CHAT, CHAT_SUMMARY, NOTEBOOK_CHAT, SOURCE_GUIDE, NOTEBOOK_SUMMARY,
# STUDIO_*; the compose file forwards the four below, add more lines there to use others.
IHSP_AI__DEFAULT__MODEL=anthropic/claude-haiku-5.5
IHSP_AI__DEFAULT__TEMPERATURE=0.2
# IHSP_AI__TASKS__STUDENT_CHAT__MODEL=
# IHSP_AI__TASKS__STUDENT_CHAT_SMART__MODEL=google/gemini-3.8-flash
# IHSP_AI__TASKS__ADMIN_CHAT__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__NOTEBOOK_CHAT__MODEL=anthropic/claude-sonnet-5.5

# ------------------------------------------------------------------ AI cost controls
# Spend is visible and limited on the admin Limits & usage page (usage ledger with cost,
# soft limits editable at runtime, extensions per user; staff are unlimited but tracked).
# These variables are only the starting values; leave them out to use the defaults.
# Days the usage ledger (one row per model call) is kept (60..3650, default 400).
# IHSP_AI__USAGE_RETENTION_DAYS=400
# Smart-tier (STUDENT_CHAT_SMART) messages per student and week; 0 switches it off (default 3).
# IHSP_LIMITS__AI_SMART_REQUESTS_PER_WEEK_STUDENT=3
# Student assistant tokens per 5-hour session window and per day.
# IHSP_LIMITS__AI_SESSION_TOKENS_STUDENT=200000
# IHSP_LIMITS__AI_DAILY_TOKENS_STUDENT=600000

# ------------------------------------------------------------------ feature flags
# All on by default; false removes a part of the product (its routes and cron jobs).
# IHSP_FEATURES__NOTEBOOKS=true
# IHSP_FEATURES__AI_ASSISTANT=true
# IHSP_FEATURES__FLASHCARDS=true
# IHSP_FEATURES__LMS=true
# IHSP_FEATURES__MAIL=true
# IHSP_FEATURES__PUSH=true
# IHSP_FEATURES__EMIS_SYNC=true
# IHSP_FEATURES__LIBRARY=true
# IHSP_FEATURES__WEB_SEARCH=true
# IHSP_FEATURES__VECTOR_SEARCH=true

# ----------------------------------------------------- outbound mail (SMTP relay)
# >>> SET <<< the provider that sends for mail.<domain> (login codes, student mail).
IHSP_SMTP_OUT__HOST=CHANGE_ME
IHSP_SMTP_OUT__PORT=587
IHSP_SMTP_OUT__USERNAME=CHANGE_ME
IHSP_SMTP_OUT__PASSWORD=CHANGE_ME
IHSP_SMTP_OUT__STARTTLS=true

# ------------------------------------------- Vault (written by scripts/prod_init.sh)
# AppRole credentials of identity and of the backup job. Do not set them by hand.
# IHSP_VAULT__ROLE_ID=
# IHSP_VAULT__SECRET_ID=
# VAULT_BACKUP_ROLE_ID=
# VAULT_BACKUP_SECRET_ID=
