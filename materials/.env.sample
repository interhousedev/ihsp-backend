IHSP_LIBRARY__UNILIBRARY_CACHE_DETAIL_TTL=86400
IHSP_LIBRARY__UNILIBRARY_STALE_TTL=604800
IHSP_LIBRARY__UNILIBRARY_BREAKER_FAILURES=3
IHSP_LIBRARY__UNILIBRARY_BREAKER_SECONDS=60
IHSP_LIBRARY__UNILIBRARY_USER_AGENT="IHSP-library/1.0 (+https://ihsu.uz)"
IHSP_LIBRARY__UNILIBRARY_CONTACT=                    # added to the User-Agent when set
IHSP_LIBRARY__UNILIBRARY_USER_SEARCHES_PER_MIN=30
IHSP_LIBRARY__UNILIBRARY_DESCRIPTION_MAX=600

# Web Push (VAPID), a second notification channel next to Telegram.
# `uv run python scripts/gen_vapid.py` prints a key pair; the private key is a secret.
# Changing the pair signs every browser out of push (they must switch it on again).
IHSP_PUSH__ENABLED=false
IHSP_PUSH__VAPID_PUBLIC_KEY=
IHSP_PUSH__VAPID_PRIVATE_KEY=
IHSP_PUSH__SUBJECT=mailto:admin@ihsu.uz
IHSP_PUSH__PER_SECOND=50
IHSP_PUSH__TIMEOUT_SECONDS=10
IHSP_PUSH__TTL_SECONDS=86400
# Hosts a subscription may point at (the server calls them); a JSON list of suffixes.
IHSP_PUSH__ENDPOINT_SUFFIXES=["googleapis.com","push.apple.com","mozilla.com","notify.windows.com"]
IHSP_LIMITS__MAIL_PER_DAY=20
IHSP_LIMITS__MAIL_RECIPIENTS=5
IHSP_LIMITS__MAIL_GLOBAL_PER_DAY=2000
IHSP_LIMITS__OTP_CODES_PER_HOUR=5
IHSP_LIMITS__OTP_FAILURES_PER_DAY=10
IHSP_LIMITS__ROOM_PIN_ATTEMPTS=5
IHSP_LIMITS__ATTENDANCE_EDIT_DAYS=7
