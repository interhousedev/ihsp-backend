# Every setting of the backend (app/settings.py), one line per variable with its default
# value (or empty), in the order of docs/reference/settings.md. Copy to .env or export.
# Prefix IHSP_, nested sections separated by __. A process reads a file named by
# IHSP_ENV_FILE; it may be a comma list that layers files, later ones winning:
#   IHSP_ENV_FILE=materials/dev.env,?.env.local   (a ? marks an optional file)
# The process environment beats all files. Values marked REQUIRED IN PROD must be set when
# the environment is prod (the app refuses to start with the development defaults).
# Secrets (API keys, passwords, tokens, private keys) are never written here: an empty
# value means "set it yourself". The few dev-stack values below are the public defaults.
# The generated table of every variable, with types and descriptions, is
# docs/reference/settings.md (`uv run python scripts/settings_reference.py`).

# --- Root ---
# IHSP_ENV_FILE=                                       # env file or comma list (see the top); not a field of Settings
IHSP_ENV=dev                                           # dev | test | prod
IHSP_LOG_LEVEL=INFO                                    # DEBUG | INFO | WARNING | ERROR
IHSP_PUBLIC_APP_NAME=IHSP                              # product name in emails, Telegram messages and the apps

# --- PostgreSQL ---
IHSP_DATABASE__URL=postgresql+asyncpg://ihsp:ihsp@localhost:5433/ihsp   # always postgresql+asyncpg://
IHSP_DATABASE__POOL_SIZE=10                            # connections kept open per process

# --- Redis (cache, rate limits, bot FSM, taskiq broker) ---
IHSP_REDIS__URL=redis://localhost:6380/0

# --- S3-compatible object storage (RustFS in dev, any S3 in prod) ---
IHSP_S3__ENDPOINT_URL=http://localhost:9000            # internal, does the real I/O
IHSP_S3__PUBLIC_ENDPOINT_URL=http://localhost:9000     # host inside presigned URLs
IHSP_S3__REGION=us-east-1
IHSP_S3__ACCESS_KEY=minio
IHSP_S3__SECRET_KEY=minio12345                         # REQUIRED IN PROD
IHSP_S3__BUCKET=ihsp-dev

# --- Vault (EMIS passwords: Transit + KV v2) ---
IHSP_VAULT__URL=http://localhost:8200
IHSP_VAULT__TOKEN=dev-root                             # dev only; in prod leave empty and use AppRole
IHSP_VAULT__ROLE_ID=                                   # REQUIRED IN PROD (AppRole)
IHSP_VAULT__SECRET_ID=                                 # REQUIRED IN PROD (AppRole)
IHSP_VAULT__VERIFY=true                                # true | false | path to a CA file
IHSP_VAULT__TRANSIT_KEY=emis-passwords                 # Transit key that encrypts the EMIS passwords
IHSP_VAULT__KV_MOUNT=secret                            # KV v2 mount of the encrypted passwords
IHSP_VAULT__KV_PREFIX=emis                             # path prefix inside the mount

# --- Ory Hydra ---
IHSP_HYDRA__PUBLIC_URL=http://localhost:4444           # token endpoint, JWKS
IHSP_HYDRA__ADMIN_URL=http://localhost:4445            # login and consent handling (internal)
IHSP_HYDRA__ISSUER=http://localhost:4444/              # must equal Hydra urls.self.issuer
IHSP_HYDRA__JWKS_CACHE_SECONDS=300

# --- Key that signs identity's own JWT assertions (RS256) ---
IHSP_JWT_BEARER__ISSUER=ihsp-identity                  # iss claim of the assertions
IHSP_JWT_BEARER__KEY_ID=ihsp-identity-1                # kid header of the assertions
IHSP_JWT_BEARER__PRIVATE_KEY_PATH=materials/dev-keys/jwt-bearer.pem   # or IHSP_JWT_BEARER__PRIVATE_KEY_PEM; REQUIRED IN PROD
# IHSP_JWT_BEARER__PRIVATE_KEY_PEM=

# --- Tokens ---
IHSP_TOKENS__ACCESS_TTL_SECONDS=600                    # lifetime of an access token
IHSP_TOKENS__REFRESH_COOKIE_SECURE=false               # REQUIRED IN PROD: true
IHSP_TOKENS__REFRESH_COOKIE_SAMESITE=lax              # lax (prod); none only for *.localhost dev (needs Secure)
IHSP_TOKENS__COOKIE_PREFIX=rt_                         # refresh cookie name prefix (the client id follows)
IHSP_TOKENS__SERVICE_TOKEN=dev-service-token           # REQUIRED IN PROD: Hydra hook and worker -> identity

# --- Telegram ---
IHSP_TELEGRAM__BOT_TOKEN=000:dev
IHSP_TELEGRAM__BOT_USERNAME=ihspbot                    # without the @
IHSP_TELEGRAM__MODE=fake                               # polling | webhook | fake
IHSP_TELEGRAM__WEBHOOK_URL=                            # webhook mode only
IHSP_TELEGRAM__WEBHOOK_SECRET=                         # webhook mode only; a secret
IHSP_TELEGRAM__ADMIN_CHAT_ID=                          # chat that gets operational alerts; empty: none
IHSP_TELEGRAM__INIT_DATA_MAX_AGE_SECONDS=3600          # how old Mini App initData may be

# --- EMIS ---
IHSP_EMIS__MODE=fake                                   # real | fake
IHSP_EMIS__BASE_URL=https://emis.edu.uz/api/v1/        # EMIS API root
IHSP_EMIS__PROFILE_PATH=student-profiles/profile/      # student profile endpoint under the base URL
IHSP_EMIS__INSTITUTION_ID=10815                        # EMIS id of the institution
IHSP_EMIS__CONCURRENCY=20                              # parallel EMIS requests
IHSP_EMIS__REQUEST_DELAY_MS=0                          # pause between EMIS requests
IHSP_EMIS__GATEWAY_URL=http://localhost:8000/internal/emis   # how other processes reach the EMIS gateway of identity
IHSP_EMIS__IMPORT_TOPICS=false                         # EMIS topics, files, videos: unreliable

# --- OpenRouter (LLM) ---
IHSP_OPENROUTER__MODE=fake                             # real | fake
IHSP_OPENROUTER__API_KEY=                              # a secret; empty with MODE=fake
IHSP_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# Deprecated, still read (with a warning); use IHSP_AI__TASKS__<TASK>__... below:
# IHSP_OPENROUTER__MODEL_STUDENT=                     -> AI__TASKS__STUDENT_CHAT__MODEL
# IHSP_OPENROUTER__MODEL_STUDENT_SMART=               -> AI__TASKS__STUDENT_CHAT_SMART__MODEL
# IHSP_OPENROUTER__MODEL_ADMIN=                       -> AI__TASKS__ADMIN_CHAT__MODEL
# IHSP_OPENROUTER__MODEL_NOTEBOOK=                    -> NOTEBOOK_CHAT and the STUDIO_* tasks
# IHSP_OPENROUTER__MODEL_NOTEBOOK_LIGHT=              -> SOURCE_GUIDE and NOTEBOOK_SUMMARY
# IHSP_OPENROUTER__NOTEBOOK_DATA_COLLECTION=          -> AI__TASKS__<TASK>__DATA_COLLECTION
IHSP_OPENROUTER__APP_URL=https://sp.ihsu.uz
IHSP_OPENROUTER__APP_TITLE=IHSP
IHSP_OPENROUTER__TIMEOUT_SECONDS=90                    # per model call

# --- Notebooks (NotebookLM-style) ---
IHSP_NOTEBOOKS__ENABLED=true                           # see also IHSP_FEATURES__NOTEBOOKS
IHSP_NOTEBOOKS__LLM_TIMEOUT_SECONDS=180                # per model call
IHSP_NOTEBOOKS__MAX_NOTEBOOKS=50                       # per student
IHSP_NOTEBOOKS__MAX_SOURCES=50                         # per notebook
IHSP_NOTEBOOKS__SOURCE_MAX_CHARS=600000                # text kept from one source
IHSP_NOTEBOOKS__NOTEBOOK_MAX_CHARS=4000000             # text of all sources of one notebook
IHSP_NOTEBOOKS__ADD_BATCH_MAX=20                       # sources one add request may carry
IHSP_NOTEBOOKS__MAX_ARTIFACTS=60                       # Studio outputs per notebook
IHSP_NOTEBOOKS__CHAT_FULL_CONTEXT_TOKENS=80000         # up to this the whole notebook goes to the chat; above it, retrieval
IHSP_NOTEBOOKS__STUDIO_CONTEXT_TOKENS=150000           # token cap of the source pack for Studio

# --- Search by meaning (docs/reference/vector-search.md; model: AI task EMBEDDING) ---
IHSP_VECTORS__QUERY_TIMEOUT_SECONDS=2.5                # a chat turn waits this long for the question vector
IHSP_VECTORS__QUERY_CACHE_SECONDS=86400                # question vectors kept in Redis
IHSP_VECTORS__DAILY_TOKEN_BUDGET=20000000              # embedding tokens per day; 0 means no limit
IHSP_VECTORS__BACKFILL_TEXTS_PER_RUN=256               # passages embedded per job run

# --- Files ---
IHSP_FILES__LMS_VIDEO_MAX_MB=500                      # largest lesson video uploaded to an LMS video block, MiB

# --- Library (library.ihsu.uz); sizes in bytes, times in seconds ---
IHSP_LIBRARY__FILE_MAX_BYTES=314572800                 # 300 MiB per book file
IHSP_LIBRARY__MATERIAL_STUDENT_MAX_BYTES=20971520      # 20 MiB
IHSP_LIBRARY__MATERIAL_STUDENT_MAX_PAGES=60
IHSP_LIBRARY__MATERIAL_TEACHER_MAX_BYTES=104857600     # 100 MiB
IHSP_LIBRARY__STUDENT_QUOTA_BYTES=314572800            # 300 MiB
IHSP_LIBRARY__TEACHER_QUOTA_BYTES=2147483648           # 2 GiB
IHSP_LIBRARY__READER_URL_SECONDS=900                   # life of a signed reader URL
IHSP_LIBRARY__TEACHER_REVIEW=false                     # true: teachers' materials also wait in the queue
IHSP_LIBRARY__LIST_MAX_ITEMS=100                       # items in one reading list
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_STUDENT=10             # uploads per student per day
IHSP_LIBRARY__LIMIT_UPLOADS_WEEK_STUDENT=40            # uploads per student per week
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_TEACHER=30             # uploads per teacher per day
IHSP_LIBRARY__LIMIT_REPORTS_DAY=10                     # reports one person may file per day
IHSP_LIBRARY__AUTO_HOLD_REPORTERS=2                    # different reporters that hide an item until a librarian decides
IHSP_LIBRARY__QUEUE_SLA_SCHOOL_DAYS=2                  # school days before the queue reminder
IHSP_LIBRARY__OFFLINE_MAX_ITEMS=5                      # items one person may keep for offline reading
IHSP_LIBRARY__OFFLINE_MAX_BYTES=419430400              # 400 MiB
# UniLibrary is a switched-off base: link-only cards, never their files.
IHSP_LIBRARY__UNILIBRARY_ENABLED=false
IHSP_LIBRARY__UNILIBRARY_ANONYMOUS_CARDS=false         # true: cards also for visitors who are not signed in
IHSP_LIBRARY__UNILIBRARY_BASE_URL=https://api.unilibrary.uz   # UniLibrary API root
IHSP_LIBRARY__UNILIBRARY_RPS=3.0                       # requests per second, all users together
IHSP_LIBRARY__UNILIBRARY_CONCURRENCY=2                 # requests in flight at once
IHSP_LIBRARY__UNILIBRARY_LIST_TIMEOUT=8.0              # seconds
IHSP_LIBRARY__UNILIBRARY_DETAIL_TIMEOUT=5.0            # seconds
IHSP_LIBRARY__UNILIBRARY_CACHE_LIST_TTL=600            # seconds a list answer is cached
IHSP_LIBRARY__UNILIBRARY_CACHE_DETAIL_TTL=86400        # seconds a card is cached
IHSP_LIBRARY__UNILIBRARY_STALE_TTL=604800              # seconds an expired answer is served while UniLibrary is down
IHSP_LIBRARY__UNILIBRARY_BREAKER_FAILURES=3            # failures in a row that open the circuit breaker
IHSP_LIBRARY__UNILIBRARY_BREAKER_SECONDS=60            # seconds the breaker stays open
IHSP_LIBRARY__UNILIBRARY_USER_AGENT="IHSP-library/1.0 (+https://ihsu.uz)"
IHSP_LIBRARY__UNILIBRARY_CONTACT=                      # added to the User-Agent when set
IHSP_LIBRARY__UNILIBRARY_USER_SEARCHES_PER_MIN=30      # searches one person may start per minute
IHSP_LIBRARY__UNILIBRARY_DESCRIPTION_MAX=600           # characters of a description kept in a card
IHSP_LIBRARY__PUBLIC_BASE_URL=http://localhost:3008    # prod https://library.ihsu.uz
IHSP_LIBRARY__TAXONOMY_CACHE_TTL=604800                # seconds the subject and topic lists are cached

# --- Web Push (VAPID), a second notification channel next to Telegram ---
# `uv run python scripts/gen_vapid.py` prints a key pair; the private key is a secret.
# Changing the pair signs every browser out of push (they must switch it on again).
IHSP_PUSH__ENABLED=false                               # delivery also needs the VAPID keys
IHSP_PUSH__VAPID_PUBLIC_KEY=                           # empty: push is off
IHSP_PUSH__VAPID_PRIVATE_KEY=                          # a secret; empty: push is off
IHSP_PUSH__SUBJECT=mailto:admin@ihsu.uz                # contact for the push services (mailto: or https:)
IHSP_PUSH__PER_SECOND=50                               # pushes sent per second
IHSP_PUSH__TIMEOUT_SECONDS=10                          # per push request
IHSP_PUSH__TTL_SECONDS=86400                           # how long a push service keeps an undelivered message
# Hosts a subscription may point at (the server calls them); a JSON list of suffixes.
IHSP_PUSH__ENDPOINT_SUFFIXES=["googleapis.com","push.apple.com","mozilla.com","notify.windows.com"]

# --- Outbound SMTP (Mailpit in dev) ---
IHSP_SMTP_OUT__HOST=localhost
IHSP_SMTP_OUT__PORT=1025
IHSP_SMTP_OUT__USERNAME=                               # relay login; empty: none
IHSP_SMTP_OUT__PASSWORD=                               # a secret; empty: none
IHSP_SMTP_OUT__STARTTLS=false                          # use STARTTLS with the relay
IHSP_SMTP_OUT__MAIL_DOMAIN=mail.ihsu.uz                # domain of the student mailboxes (<login>@<domain>)
IHSP_SMTP_OUT__SYSTEM_FROM=no-reply@ihsu.uz            # sender of system emails (activation, reset)

# --- Email sent by people from the platform (compose dialog); Mailpit in dev ---
IHSP_MAIL__OUTBOUND__ENABLED=false                     # let students and staff send email from the platform
IHSP_MAIL__OUTBOUND__HOST=localhost                    # SMTP host
IHSP_MAIL__OUTBOUND__PORT=1025                         # SMTP port (465: implicit TLS)
IHSP_MAIL__OUTBOUND__USER=                             # SMTP login; empty: none
IHSP_MAIL__OUTBOUND__PASSWORD=                         # a secret; empty: none
IHSP_MAIL__OUTBOUND__FROM_ADDRESS=no-reply@ihsu.uz     # sender address; the user's name is the display name
IHSP_MAIL__OUTBOUND__STARTTLS=false                    # use STARTTLS
IHSP_MAIL__OUTBOUND__PER_USER_PER_DAY=20               # emails one user may send per day
IHSP_MAIL__OUTBOUND__MAX_RECIPIENTS=5                  # recipients in one email

# --- Inbound SMTP server ---
IHSP_SMTP_IN__HOST=0.0.0.0                             # all interfaces
IHSP_SMTP_IN__PORT=2525                                # 25 in prod
IHSP_SMTP_IN__TLS_CERT_PATH=                           # STARTTLS certificate; empty: no STARTTLS
IHSP_SMTP_IN__TLS_KEY_PATH=                            # STARTTLS private key
IHSP_SMTP_IN__MAX_BYTES=26214400                       # largest accepted message (25 MiB)
IHSP_SMTP_IN__CHECK_SPF=false                          # true in prod
IHSP_SMTP_IN__CHECK_DKIM=false                         # true in prod

# --- Public origins ---
IHSP_URLS__ID=http://localhost:3001
IHSP_URLS__SP=http://localhost:3002
IHSP_URLS__STAFF=http://localhost:3003
IHSP_URLS__ADMIN=http://localhost:3004
IHSP_URLS__LMS=http://localhost:3005
IHSP_URLS__SHARE=http://localhost:3006
IHSP_URLS__APP=http://localhost:3007
IHSP_URLS__LIBRARY=http://localhost:3008
IHSP_URLS__SHORT_LINKS=http://localhost:8000/s         # prod https://s.ihsu.uz
IHSP_URLS__ROOMS=http://localhost:8000/r               # prod https://ihsu.uz/r
IHSP_URLS__API=http://localhost:8000
IHSP_URLS__MCP=http://localhost:8000/mcp

# --- Installable app (PWA at app.<domain>) ---
# Versions served by GET /v1/app/version. The app compares its build version with them:
#   LATEST        newest build; an older client offers an update.
#   MIN_SUPPORTED oldest build allowed to keep running; clients below it update immediately
#                 (forced update). Raise it to push everybody onto a new build (LATEST >= MIN_SUPPORTED).
IHSP_APP__LATEST=1.0.0
IHSP_APP__MIN_SUPPORTED=1.0.0

# --- Limits (quotas; *_STUDENT and *_ADMIN belong to that role, the rest to everyone) ---
# Prefixes: AI_ assistants, NB_ notebooks, LMS_AI_ course workspaces, WEB_SEARCH_ web search.
# Token budgets count model tokens times the task's BUDGET_WEIGHT.
IHSP_LIMITS__STORAGE_STUDENT_BYTES=1610612736          # 1.5 GiB
IHSP_LIMITS__STORAGE_STAFF_BYTES=10737418240           # 10 GiB, teacher or admin
IHSP_LIMITS__FILE_MAX_BYTES=104857600                  # largest single upload (100 MiB)
IHSP_LIMITS__AI_TEXT_MAX_BYTES=102400                  # largest file text the assistant opens (100 KiB)
IHSP_LIMITS__AI_SESSION_HOURS=5                        # length of an assistant budget window
IHSP_LIMITS__AI_SESSION_TOKENS_STUDENT=200000
IHSP_LIMITS__AI_DAILY_TOKENS_STUDENT=600000
IHSP_LIMITS__AI_MAX_TOOL_STEPS=8                       # tool calls per assistant answer
# IHSP_LIMITS__AI_SMART_WEIGHT=                        # deprecated -> AI__TASKS__STUDENT_CHAT_SMART__BUDGET_WEIGHT
IHSP_LIMITS__MAIL_PER_DAY=20                           # messages a student may send per day
IHSP_LIMITS__MAIL_RECIPIENTS=5                         # recipients in one message
IHSP_LIMITS__MAIL_GLOBAL_PER_DAY=2000                  # messages the whole system may send per day
IHSP_LIMITS__OTP_CODES_PER_HOUR=5                      # one-time codes sent to one account per hour
IHSP_LIMITS__OTP_FAILURES_PER_DAY=10                   # wrong code attempts per account per day
IHSP_LIMITS__ROOM_PIN_ATTEMPTS=5                       # reserved, nothing reads it yet
IHSP_LIMITS__ATTENDANCE_EDIT_DAYS=7                    # days after a lesson its attendance can be edited
IHSP_LIMITS__NB_SESSION_TOKENS_STUDENT=1500000
IHSP_LIMITS__NB_DAILY_TOKENS_STUDENT=4000000
IHSP_LIMITS__NB_ARTIFACTS_PER_DAY=20
IHSP_LIMITS__NB_AUDIO_PER_DAY=0                        # 0: the counter is off (the kind is not built)
IHSP_LIMITS__NB_SLIDES_PER_DAY=6
IHSP_LIMITS__NB_INFOGRAPHICS_PER_DAY=6
IHSP_LIMITS__NB_CONCURRENT_ARTIFACTS=3                 # Studio outputs generating at once per student
IHSP_LIMITS__NB_CHAT_PER_MINUTE=10
IHSP_LIMITS__NB_SOURCE_ADDS_PER_HOUR=60
IHSP_LIMITS__NB_SEARCH_PER_MINUTE=30
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STUDENT=10             # 0 forbids web search; deep costs WEB_SEARCH_DEEP_QUERIES
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STAFF=30
IHSP_LIMITS__WEB_SEARCH_MAX_RESULTS=5                  # chat answer, 1-10
IHSP_LIMITS__WEB_SEARCH_DISCOVER_RESULTS=8             # Discover fast, 1-20
IHSP_LIMITS__WEB_SEARCH_DEEP_QUERIES=3                 # Discover deep, 1-5
IHSP_LIMITS__WEB_SEARCH_DEEP_RESULTS=12                # kept after ranking, 1-25
IHSP_LIMITS__LMS_AI_SESSION_TOKENS=1500000             # course workspaces, per staff member
IHSP_LIMITS__LMS_AI_DAILY_TOKENS=4000000
IHSP_LIMITS__LMS_AI_ARTIFACTS_PER_DAY=30
IHSP_LIMITS__LMS_AI_CHAT_PER_MINUTE=12
IHSP_LIMITS__LMS_AI_MAX_TOOL_STEPS=12                  # tool calls per author assistant answer

# --- AI models: one default and an override per task (docs/reference/settings.md) ---
# Every place that calls a language model is a task: STUDENT_CHAT, STUDENT_CHAT_SMART,
# ADMIN_CHAT, CHAT_SUMMARY, NOTEBOOK_CHAT, SOURCE_GUIDE, NOTEBOOK_SUMMARY, STUDIO_REPORT,
# STUDIO_MIND_MAP, STUDIO_FLASHCARDS, STUDIO_QUIZ, STUDIO_DATA_TABLE, STUDIO_SLIDES,
# STUDIO_SLIDES_REVISE, STUDIO_INFOGRAPHIC, LMS_AUTHORING (course author assistant), WEB_SEARCH,
# SUBJECT_TRANSLATE (translates the missing uz/ru/en names of an EMIS subject; cheap model),
# DISCOVER (both ship with a cheap search model and DATA_COLLECTION deny) and EMBEDDING
# (vectors for search by meaning: its model, vector size and batch size are fixed together
# with the vectors table, so change the model only with a re-embedding migration). A task uses its
# own IHSP_AI__TASKS__<TASK>__<FIELD>, else the built-in value of the task (the smart tier
# ships with a larger model and BUDGET_WEIGHT 4; notebook tasks send DATA_COLLECTION deny),
# else IHSP_AI__DEFAULT__<FIELD>. Lists are comma separated.
IHSP_AI__DEFAULT__MODEL=anthropic/claude-haiku-4.5
IHSP_AI__DEFAULT__TEMPERATURE=0.2
IHSP_AI__DEFAULT__MAX_OUTPUT_TOKENS=                   # empty: each call site's own size
IHSP_AI__DEFAULT__REASONING_EFFORT=                    # empty | low | medium | high
IHSP_AI__DEFAULT__FALLBACKS=                           # e.g. anthropic/claude-haiku-4.5
IHSP_AI__DEFAULT__BUDGET_WEIGHT=1
IHSP_AI__DEFAULT__DATA_COLLECTION=                     # empty | deny | allow
IHSP_AI__DEFAULT__PROVIDER_ORDER=                      # e.g. anthropic,google-vertex
IHSP_AI__DEFAULT__MODALITIES=text,image,audio,video,pdf # inputs the model reads; other sources stay in the notebook but are not sent
# Per task, replace <TASK> with one of the names above. Empty: the built-in value of the
# task, else the default.
# IHSP_AI__TASKS__<TASK>__MODEL=                       # OpenRouter model id
# IHSP_AI__TASKS__<TASK>__TEMPERATURE=
# IHSP_AI__TASKS__<TASK>__MAX_OUTPUT_TOKENS=           # replaces the call site's own size
# IHSP_AI__TASKS__<TASK>__REASONING_EFFORT=            # low | medium | high
# IHSP_AI__TASKS__<TASK>__FALLBACKS=                   # comma list of models
# IHSP_AI__TASKS__<TASK>__BUDGET_WEIGHT=               # budget multiplier of this task's tokens
# IHSP_AI__TASKS__<TASK>__DATA_COLLECTION=             # deny | allow
# IHSP_AI__TASKS__<TASK>__PROVIDER_ORDER=              # comma list of providers
# IHSP_AI__TASKS__<TASK>__MODALITIES=                  # text,image,audio,video,pdf: a source of another kind is shown with a warning and not sent
# EMBEDDING only (docs/reference/vector-search.md):
# IHSP_AI__TASKS__<TASK>__DIMENSIONS=                  # vector size, must equal the vectors.embeddings column
# IHSP_AI__TASKS__<TASK>__BATCH_SIZE=                  # texts per request
# IHSP_AI__TASKS__<TASK>__QUERY_PREFIX=                # text put before a question (e5: "query: "); none: no prefix
# IHSP_AI__TASKS__<TASK>__DOCUMENT_PREFIX=             # text put before a passage (e5: "passage: ")
# Examples:
# IHSP_AI__TASKS__STUDENT_CHAT_SMART__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__STUDENT_CHAT_SMART__BUDGET_WEIGHT=4
# IHSP_AI__TASKS__SUBJECT_TRANSLATE__MODEL=google/gemini-3.5-flash-lite   # the shipped default: one small call per EMIS subject with a missing name
# IHSP_AI__TASKS__ADMIN_CHAT__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__NOTEBOOK_CHAT__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__STUDIO_QUIZ__TEMPERATURE=0.4
# IHSP_AI__TASKS__STUDIO_SLIDES__MAX_OUTPUT_TOKENS=16000
# IHSP_AI__TASKS__STUDIO_SLIDES__FALLBACKS=anthropic/claude-haiku-4.5

# --- Feature flags (all on by default; off removes the routes and the cron jobs) ---
IHSP_FEATURES__NOTEBOOKS=true
IHSP_FEATURES__AI_ASSISTANT=true
IHSP_FEATURES__FLASHCARDS=true
IHSP_FEATURES__LMS=true
IHSP_FEATURES__MAIL=true
IHSP_FEATURES__PUSH=true                               # delivery also needs IHSP_PUSH__ENABLED
IHSP_FEATURES__EMIS_SYNC=true
IHSP_FEATURES__LIBRARY=true                            # library routes and cron jobs
IHSP_FEATURES__WEB_SEARCH=true                         # off: web search requests answer web-search/disabled
IHSP_FEATURES__VECTOR_SEARCH=true                      # off: lexical retrieval only, nothing embedded; needs pgvector
IHSP_FEATURES__CHANGE_PASSWORD_ON_LOGIN=false          # opt-in: a password set by an admin must be changed at the next login

# --- Web search (docs/reference/settings.md; models: AI tasks WEB_SEARCH and DISCOVER) ---
IHSP_WEB_SEARCH__SURFACE=plugin                        # plugin | server_tool
IHSP_WEB_SEARCH__ENGINE=exa                            # exa | parallel | perplexity
IHSP_WEB_SEARCH__MODE=                                 # empty: the engine's own default
IHSP_WEB_SEARCH__BLOCKED_DOMAINS=                      # comma list; empty keeps the built-in list
IHSP_WEB_SEARCH__SNIPPET_CHARS=1200                    # 200-4000
IHSP_WEB_SEARCH__TIMEOUT_SECONDS=45                    # 5-180
IHSP_WEB_SEARCH__DB_FIRST__ENABLED=true                 # look in the platform database before the web
IHSP_WEB_SEARCH__DB_FIRST__MIN_COVERAGE=0.7            # 0-1, share of query terms dense passages cover to skip the web
IHSP_WEB_SEARCH__DB_FIRST__MIN_PASSAGES=3              # 1-20, dense passages needed to skip the web
IHSP_WEB_SEARCH__DB_FIRST__MIN_DENSITY=0.2             # on-topic tokens / all tokens a passage needs
IHSP_WEB_SEARCH__DB_FIRST__CANDIDATES=12               # 1-50, passages asked from the database
