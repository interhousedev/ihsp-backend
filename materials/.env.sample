# Every setting of the backend (app/settings.py). Copy to .env or export as variables.
# Prefix IHSP_, nested sections separated by __. `IHSP_ENV_FILE=<path>` makes a process
# read such a file; it may be a comma list that layers files, later ones winning:
# `IHSP_ENV_FILE=materials/dev.env,?.env.local` (a ? marks an optional file). The process
# environment beats all files. Values marked REQUIRED IN PROD must be set when
# IHSP_ENV=prod (the app refuses to start with the development defaults).
# The generated table of every variable, with types and descriptions, is
# docs/reference/settings.md (`uv run python scripts/settings_reference.py`).

# --- root ---
IHSP_ENV=dev                         # dev | test | prod
IHSP_LOG_LEVEL=INFO
IHSP_PUBLIC_APP_NAME=IHSP

# --- PostgreSQL ---
IHSP_DATABASE__URL=postgresql+asyncpg://ihsp:ihsp@localhost:5433/ihsp   # always postgresql+asyncpg://
IHSP_DATABASE__POOL_SIZE=10

# --- Redis (cache, rate limits, bot FSM, taskiq broker) ---
IHSP_REDIS__URL=redis://localhost:6380/0

# --- S3-compatible object storage (RustFS in dev, any S3 in prod) ---
IHSP_S3__ENDPOINT_URL=http://localhost:9000           # internal, does the real I/O
IHSP_S3__PUBLIC_ENDPOINT_URL=http://localhost:9000    # host inside presigned URLs
IHSP_S3__REGION=us-east-1
IHSP_S3__ACCESS_KEY=minio
IHSP_S3__SECRET_KEY=minio12345                        # REQUIRED IN PROD
IHSP_S3__BUCKET=ihsp-dev

# --- Vault (EMIS passwords: Transit + KV v2) ---
IHSP_VAULT__URL=http://localhost:8200
IHSP_VAULT__TOKEN=dev-root                            # dev only; in prod leave empty and use AppRole
IHSP_VAULT__ROLE_ID=                                  # REQUIRED IN PROD (AppRole)
IHSP_VAULT__SECRET_ID=                                # REQUIRED IN PROD (AppRole)
IHSP_VAULT__VERIFY=true                               # true | false | path to a CA file
IHSP_VAULT__TRANSIT_KEY=emis-passwords
IHSP_VAULT__KV_MOUNT=secret
IHSP_VAULT__KV_PREFIX=emis

# --- Ory Hydra ---
IHSP_HYDRA__PUBLIC_URL=http://localhost:4444
IHSP_HYDRA__ADMIN_URL=http://localhost:4445
IHSP_HYDRA__ISSUER=http://localhost:4444/              # must equal Hydra urls.self.issuer
IHSP_HYDRA__JWKS_CACHE_SECONDS=300

# --- Key that signs identity's own JWT assertions (RS256) ---
IHSP_JWT_BEARER__ISSUER=ihsp-identity
IHSP_JWT_BEARER__KEY_ID=ihsp-identity-1
IHSP_JWT_BEARER__PRIVATE_KEY_PATH=materials/dev-keys/jwt-bearer.pem   # or IHSP_JWT_BEARER__PRIVATE_KEY_PEM; REQUIRED IN PROD
# IHSP_JWT_BEARER__PRIVATE_KEY_PEM=

# --- Tokens ---
IHSP_TOKENS__ACCESS_TTL_SECONDS=600
IHSP_TOKENS__REFRESH_COOKIE_SECURE=false              # REQUIRED IN PROD: true
IHSP_TOKENS__COOKIE_PREFIX=rt_
IHSP_TOKENS__SERVICE_TOKEN=dev-service-token          # REQUIRED IN PROD: Hydra hook and worker -> identity

# --- Telegram ---
IHSP_TELEGRAM__BOT_TOKEN=000:dev
IHSP_TELEGRAM__BOT_USERNAME=ihspbot
IHSP_TELEGRAM__MODE=fake                              # polling | webhook | fake
IHSP_TELEGRAM__WEBHOOK_URL=
IHSP_TELEGRAM__WEBHOOK_SECRET=
IHSP_TELEGRAM__ADMIN_CHAT_ID=
IHSP_TELEGRAM__INIT_DATA_MAX_AGE_SECONDS=3600

# --- EMIS ---
IHSP_EMIS__MODE=fake                                  # real | fake
IHSP_EMIS__BASE_URL=https://emis.edu.uz/api/v1/
IHSP_EMIS__PROFILE_PATH=student-profiles/profile/
IHSP_EMIS__INSTITUTION_ID=10815
IHSP_EMIS__CONCURRENCY=20
IHSP_EMIS__REQUEST_DELAY_MS=0
IHSP_EMIS__GATEWAY_URL=http://localhost:8000/internal/emis
IHSP_EMIS__IMPORT_TOPICS=false                        # EMIS topics, files, videos: unreliable

# --- OpenRouter (LLM) ---
IHSP_OPENROUTER__MODE=fake                            # real | fake
IHSP_OPENROUTER__API_KEY=
IHSP_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
IHSP_OPENROUTER__APP_URL=https://sp.ihsu.uz
IHSP_OPENROUTER__APP_TITLE=IHSP
IHSP_OPENROUTER__TIMEOUT_SECONDS=90
# Deprecated, still read (with a warning); use IHSP_AI__TASKS__<TASK>__... below:
# IHSP_OPENROUTER__MODEL_STUDENT=                     -> AI__TASKS__STUDENT_CHAT__MODEL
# IHSP_OPENROUTER__MODEL_STUDENT_SMART=               -> AI__TASKS__STUDENT_CHAT_SMART__MODEL
# IHSP_OPENROUTER__MODEL_ADMIN=                       -> AI__TASKS__ADMIN_CHAT__MODEL
# IHSP_OPENROUTER__MODEL_NOTEBOOK=                    -> NOTEBOOK_CHAT and the STUDIO_* tasks
# IHSP_OPENROUTER__MODEL_NOTEBOOK_LIGHT=              -> SOURCE_GUIDE and NOTEBOOK_SUMMARY
# IHSP_OPENROUTER__NOTEBOOK_DATA_COLLECTION=          -> AI__TASKS__<TASK>__DATA_COLLECTION

# --- AI models: one default and an override per task (docs/reference/settings.md) ---
# Every place that calls a language model is a task: STUDENT_CHAT, STUDENT_CHAT_SMART,
# ADMIN_CHAT, CHAT_SUMMARY, NOTEBOOK_CHAT, SOURCE_GUIDE, NOTEBOOK_SUMMARY, STUDIO_REPORT,
# STUDIO_MIND_MAP, STUDIO_FLASHCARDS, STUDIO_QUIZ, STUDIO_DATA_TABLE, STUDIO_SLIDES,
# STUDIO_SLIDES_REVISE, STUDIO_INFOGRAPHIC, LMS_AUTHORING (course author assistant), WEB_SEARCH,
# DISCOVER (both ship with a cheap search model and DATA_COLLECTION deny) and EMBEDDING
# (vectors for search by meaning: its model, vector size and batch size are fixed together
# with the vectors table, so change the model only with a re-embedding migration). A task uses its
# own IHSP_AI__TASKS__<TASK>__<FIELD>, else the built-in value of the task (the smart tier
# ships with a larger model and BUDGET_WEIGHT 4; notebook tasks send DATA_COLLECTION deny),
# else IHSP_AI__DEFAULT__<FIELD>. Lists are comma separated.
IHSP_AI__DEFAULT__MODEL=anthropic/claude-haiku-4.5
IHSP_AI__DEFAULT__TEMPERATURE=0.2
IHSP_AI__DEFAULT__MAX_OUTPUT_TOKENS=                  # empty: each call site's own size
IHSP_AI__DEFAULT__REASONING_EFFORT=                   # empty | low | medium | high
IHSP_AI__DEFAULT__FALLBACKS=                          # e.g. anthropic/claude-haiku-4.5
IHSP_AI__DEFAULT__BUDGET_WEIGHT=1
IHSP_AI__DEFAULT__DATA_COLLECTION=                    # empty | deny | allow
IHSP_AI__DEFAULT__PROVIDER_ORDER=                     # e.g. anthropic,google-vertex
# Per task (fields: MODEL TEMPERATURE MAX_OUTPUT_TOKENS REASONING_EFFORT FALLBACKS
# BUDGET_WEIGHT DATA_COLLECTION PROVIDER_ORDER), for example:
# IHSP_AI__TASKS__STUDENT_CHAT_SMART__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__STUDENT_CHAT_SMART__BUDGET_WEIGHT=4
# IHSP_AI__TASKS__ADMIN_CHAT__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__NOTEBOOK_CHAT__MODEL=anthropic/claude-sonnet-5.5
# IHSP_AI__TASKS__STUDIO_QUIZ__TEMPERATURE=0.4
# IHSP_AI__TASKS__STUDIO_SLIDES__MAX_OUTPUT_TOKENS=16000
# IHSP_AI__TASKS__STUDIO_SLIDES__FALLBACKS=anthropic/claude-haiku-4.5

# --- Web search (docs/reference/settings.md; models: AI tasks WEB_SEARCH and DISCOVER) ---
IHSP_WEB_SEARCH__SURFACE=plugin                       # plugin | server_tool
IHSP_WEB_SEARCH__ENGINE=exa                           # exa | parallel | perplexity
IHSP_WEB_SEARCH__MODE=                                # empty: the engine's own default
IHSP_WEB_SEARCH__BLOCKED_DOMAINS=                     # comma list; empty keeps the built-in list
IHSP_WEB_SEARCH__SNIPPET_CHARS=1200                   # 200-4000
IHSP_WEB_SEARCH__TIMEOUT_SECONDS=45                   # 5-180

# --- Search by meaning (docs/reference/vector-search.md; model: AI task EMBEDDING) ---
IHSP_VECTORS__QUERY_TIMEOUT_SECONDS=2.5               # a chat turn waits this long for the question vector
IHSP_VECTORS__QUERY_CACHE_SECONDS=86400               # question vectors kept in Redis
IHSP_VECTORS__DAILY_TOKEN_BUDGET=20000000             # embedding tokens per day; 0 means no limit
IHSP_VECTORS__BACKFILL_TEXTS_PER_RUN=256              # passages embedded per job run

# --- Feature flags (all on by default; off removes the routes and the cron jobs) ---
IHSP_FEATURES__NOTEBOOKS=true
IHSP_FEATURES__AI_ASSISTANT=true
IHSP_FEATURES__FLASHCARDS=true
IHSP_FEATURES__LMS=true
IHSP_FEATURES__MAIL=true
IHSP_FEATURES__PUSH=true                              # delivery also needs IHSP_PUSH__ENABLED
IHSP_FEATURES__EMIS_SYNC=true
IHSP_FEATURES__LIBRARY=true                           # library routes and cron jobs
IHSP_FEATURES__WEB_SEARCH=true                        # off: web search requests answer web-search/disabled
IHSP_FEATURES__VECTOR_SEARCH=true                     # off: lexical retrieval only, nothing embedded; needs pgvector

# --- Outbound SMTP (Mailpit in dev) ---
IHSP_SMTP_OUT__HOST=localhost
IHSP_SMTP_OUT__PORT=1025
IHSP_SMTP_OUT__USERNAME=
IHSP_SMTP_OUT__PASSWORD=
IHSP_SMTP_OUT__STARTTLS=false
IHSP_SMTP_OUT__MAIL_DOMAIN=mail.ihsu.uz
IHSP_SMTP_OUT__SYSTEM_FROM=no-reply@ihsu.uz

# --- Inbound SMTP server ---
IHSP_SMTP_IN__HOST=0.0.0.0
IHSP_SMTP_IN__PORT=2525                               # 25 in prod
IHSP_SMTP_IN__TLS_CERT_PATH=
IHSP_SMTP_IN__TLS_KEY_PATH=
IHSP_SMTP_IN__MAX_BYTES=26214400
IHSP_SMTP_IN__CHECK_SPF=false                         # true in prod
IHSP_SMTP_IN__CHECK_DKIM=false                        # true in prod

# --- Public origins ---
IHSP_URLS__ID=http://localhost:3001
IHSP_URLS__SP=http://localhost:3002
IHSP_URLS__APP=http://localhost:3007
IHSP_URLS__STAFF=http://localhost:3003
IHSP_URLS__ADMIN=http://localhost:3004
IHSP_URLS__LMS=http://localhost:3005
IHSP_URLS__SHARE=http://localhost:3006
IHSP_URLS__LIBRARY=http://localhost:3008
IHSP_URLS__SHORT_LINKS=http://localhost:8000/s        # prod https://s.ihsu.uz
IHSP_URLS__ROOMS=http://localhost:8000/r              # prod https://ihsu.uz/r
IHSP_URLS__API=http://localhost:8000
IHSP_URLS__MCP=http://localhost:8000/mcp

# --- Installable app (PWA at app.<domain>) ---
# Versions served by GET /v1/app/version. The app compares its build version with them:
#   LATEST        newest build; an older client offers an update.
#   MIN_SUPPORTED oldest build allowed to keep running; clients below it update immediately
#                 (forced update). Raise it to push everybody onto a new build (LATEST >= MIN_SUPPORTED).
# IHSP_APP__LATEST=1.0.0
# IHSP_APP__MIN_SUPPORTED=1.0.0

# --- Limits (quotas; *_STUDENT and *_ADMIN belong to that role, the rest to everyone) ---
IHSP_LIMITS__STORAGE_STUDENT_BYTES=1610612736
IHSP_LIMITS__STORAGE_STAFF_BYTES=10737418240
IHSP_LIMITS__FILE_MAX_BYTES=104857600
IHSP_LIMITS__AI_TEXT_MAX_BYTES=102400
IHSP_LIMITS__AI_SESSION_HOURS=5
IHSP_LIMITS__AI_SESSION_TOKENS_STUDENT=200000
IHSP_LIMITS__AI_DAILY_TOKENS_STUDENT=600000
IHSP_LIMITS__AI_SESSION_TOKENS_ADMIN=400000
IHSP_LIMITS__AI_DAILY_TOKENS_ADMIN=1200000
IHSP_LIMITS__AI_MAX_TOOL_STEPS=8
# IHSP_LIMITS__AI_SMART_WEIGHT=                       # deprecated -> AI__TASKS__STUDENT_CHAT_SMART__BUDGET_WEIGHT
IHSP_LIMITS__NB_SESSION_TOKENS_STUDENT=1500000
IHSP_LIMITS__NB_DAILY_TOKENS_STUDENT=4000000
IHSP_LIMITS__NB_ARTIFACTS_PER_DAY=20
IHSP_LIMITS__NB_AUDIO_PER_DAY=0
IHSP_LIMITS__NB_SLIDES_PER_DAY=6
IHSP_LIMITS__NB_INFOGRAPHICS_PER_DAY=6
IHSP_LIMITS__NB_CONCURRENT_ARTIFACTS=3
IHSP_LIMITS__NB_CHAT_PER_MINUTE=10
IHSP_LIMITS__NB_SOURCE_ADDS_PER_HOUR=60
IHSP_LIMITS__NB_SEARCH_PER_MINUTE=30
IHSP_LIMITS__LMS_AI_SESSION_TOKENS=1500000            # course workspaces, per staff member
IHSP_LIMITS__LMS_AI_DAILY_TOKENS=4000000
IHSP_LIMITS__LMS_AI_ARTIFACTS_PER_DAY=30
IHSP_LIMITS__LMS_AI_CHAT_PER_MINUTE=12
IHSP_LIMITS__LMS_AI_MAX_TOOL_STEPS=12
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STUDENT=10            # 0 forbids web search; deep costs WEB_SEARCH_DEEP_QUERIES
IHSP_LIMITS__WEB_SEARCH_PER_DAY_STAFF=30
IHSP_LIMITS__WEB_SEARCH_MAX_RESULTS=5                 # chat answer, 1-10
IHSP_LIMITS__WEB_SEARCH_DISCOVER_RESULTS=8            # Discover fast, 1-20
IHSP_LIMITS__WEB_SEARCH_DEEP_QUERIES=3                # Discover deep, 1-5
IHSP_LIMITS__WEB_SEARCH_DEEP_RESULTS=12               # kept after ranking, 1-25

# Notebooks (NotebookLM-style)
IHSP_NOTEBOOKS__ENABLED=true
IHSP_NOTEBOOKS__LLM_TIMEOUT_SECONDS=180
IHSP_NOTEBOOKS__MAX_NOTEBOOKS=50
IHSP_NOTEBOOKS__MAX_SOURCES=50
IHSP_NOTEBOOKS__SOURCE_MAX_CHARS=600000
IHSP_NOTEBOOKS__NOTEBOOK_MAX_CHARS=4000000
IHSP_NOTEBOOKS__ADD_BATCH_MAX=20
IHSP_NOTEBOOKS__MAX_ARTIFACTS=60
IHSP_NOTEBOOKS__CHAT_FULL_CONTEXT_TOKENS=80000
IHSP_NOTEBOOKS__STUDIO_CONTEXT_TOKENS=150000

