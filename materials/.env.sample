IHSP_LIBRARY__STUDENT_QUOTA_BYTES=314572800          # 300 MiB
IHSP_LIBRARY__TEACHER_QUOTA_BYTES=2147483648         # 2 GiB
IHSP_LIBRARY__READER_URL_SECONDS=900
IHSP_LIBRARY__TEACHER_REVIEW=false                   # true: teachers' materials also wait in the queue
IHSP_LIBRARY__LIST_MAX_ITEMS=100
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_STUDENT=10
IHSP_LIBRARY__LIMIT_UPLOADS_WEEK_STUDENT=40
IHSP_LIBRARY__LIMIT_UPLOADS_DAY_TEACHER=30
IHSP_LIBRARY__LIMIT_REPORTS_DAY=10
IHSP_LIBRARY__AUTO_HOLD_REPORTERS=2
IHSP_LIBRARY__QUEUE_SLA_SCHOOL_DAYS=2
IHSP_LIBRARY__OFFLINE_MAX_ITEMS=5
IHSP_LIBRARY__OFFLINE_MAX_BYTES=419430400            # 400 MiB
IHSP_LIBRARY__PUBLIC_BASE_URL=http://localhost:3008  # prod https://library.ihsu.uz
IHSP_LIBRARY__TAXONOMY_CACHE_TTL=604800
