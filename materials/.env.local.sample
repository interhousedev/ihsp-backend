# Optional overrides for the local full stack (materials/docker-compose.local.yaml).
# Copy to backend/.env.local; scripts/local_up.sh and local_down.sh pick it up. Without the
# file everything runs on fake EMIS, fake OpenRouter and a fake Telegram sender.
# Values here are development values: never put production secrets into this file.

# --- external services (default: fake) -------------------------------------------------
# IHSP_EMIS__MODE=real
# IHSP_OPENROUTER__MODE=real
# IHSP_OPENROUTER__API_KEY=sk-or-...
# IHSP_TELEGRAM__MODE=fake        # `polling` needs a real token and starts getUpdates
# IHSP_TELEGRAM__BOT_TOKEN=000:dev
# IHSP_TELEGRAM__BOT_USERNAME=ihspbot

# --- host names and ports --------------------------------------------------------------
# Hosts are id.<LOCAL_DOMAIN>, sp.<...>, staff.<...>, admin.<...>, lms.<...>, s.<...>,
# api.<...>, mcp.<...> and <LOCAL_DOMAIN>/r/ for room pages. Every *.localhost name
# resolves to 127.0.0.1 in browsers.
# LOCAL_DOMAIN=localhost
# Port 80 busy? Change both lines (the suffix goes into every public URL).
# LOCAL_HTTP_PORT=8080
# LOCAL_PORT_SUFFIX=:8080
# LOCAL_S3_PORT=9100              # presigned upload and download URLs point here
# LOCAL_S3_CONSOLE_PORT=9101
# LOCAL_MAILPIT_PORT=8026         # web UI with login codes and outgoing mail
# LOCAL_SMTP_PORT=2525            # inbound SMTP of the mail process

# --- misc ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
