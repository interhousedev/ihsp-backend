# Python, uv and tool caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.profraw

# Development secrets generated by scripts/dev.sh (materials/dev-keys has its own deny-all .gitignore)
materials/dev-keys/*.pem
materials/dev-keys/*.env

# Deployment secrets and data (scripts/prod_init.sh, local_up.sh, backup.sh): never commit.
# Anchored to the root so test fixture folders such as tests/lms/cartridge/data/ stay tracked.
.env
.env.prod
.env.local
.env.*.local
/secrets/
/data/
/backups/
*.key
*.age
vault-init*.txt

# Eval harness outputs (scripts/nb_eval_slides.py): model answers and HTML snapshots
eval/out/

# Agent markers and local Claude Code settings
.b0*-done
.claude/settings.local.json

# Logs, dumps, scratch
*.log
*.dump
*.sql.gz
*.tar.age
scratch/
tmp/

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local CI and security scan reports (scripts/ci_local.sh, scripts/security_scan.sh)
/reports/
